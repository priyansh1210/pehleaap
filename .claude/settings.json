{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/session_start.sh\"",
            "timeout": 30,
            "statusMessage": "Pulling shared memory from GitHub"
          }
        ]
      }
    ]
  }
}
